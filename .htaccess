

<IfModule mod_rewrite.c>

RedirectMatch 404 /\.git
RedirectMatch 404 /\.env
RedirectMatch 404 /composer\.json
RedirectMatch 404 /package(-lock)?\.json
RedirectMatch 404 \.(ini|log|conf|bak|backup|old|orig|sql|dump|tar|zip)$

    RewriteEngine On
    RewriteBase /

    # Preserve Authorization header for PHP / CodeIgniter
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Block access to Git repository
# Block .git directory and everything inside it
RedirectMatch 404 /\.git

# Block .env files
RedirectMatch 404 /\.env

# Block other environment/config files
RedirectMatch 404 /\.(env|ini|log|conf|config)$

# Block Git and version-control files
RedirectMatch 404 /\.(git|gitignore|gitattributes|gitmodules)

# Block common backup/database/archive files
RedirectMatch 404 \.(bak|backup|old|orig|save|swp|swo|sql|sql\.gz|dump|tar|tar\.gz|zip)$

# Block common sensitive configuration files
RedirectMatch 404 /(composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|phpunit\.xml)$

# Block server/config files
RedirectMatch 404 /(Dockerfile|docker-compose\.ya?ml|Makefile)$

    RewriteRule ^index\.php$ - [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.php [L]
</IfModule>